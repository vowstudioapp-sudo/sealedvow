{
  "framework": "vite",
  "buildCommand": "vite build",
  "devCommand": "vite --port $PORT",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    {
      "source": "/((?!api/|@vite|@react-refresh|@fs/|@id/|node_modules/|src/|assets/|styles/|.*\\.).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/ai.js": {
      "maxDuration": 60
    },
    "api/generate-eid-letter.js": {
      "maxDuration": 60
    },
    "api/create-order.js": {
      "maxDuration": 30
    },
    "api/verify-payment.js": {
      "maxDuration": 30
    },
    "api/admin-generate-founder-codes.js": {
      "maxDuration": 30
    },
    "api/load-session.js": {
      "maxDuration": 10
    },
    "api/save-reply.js": {
      "maxDuration": 10
    },
    "api/upload-media.js": {
      "maxDuration": 30
    },
    "api/razorpay-webhook.js": {
      "maxDuration": 10
    },
    "api/admin/reconcile-payments.js": {
      "maxDuration": 60
    },
    "api/admin/orphan-audit.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    { "path": "/api/admin/reconcile-payments", "schedule": "30 20 * * *" }
  ]
}